[Unit]
Description=VoteKit durable email delivery worker
After=network-online.target votekit.service
Wants=network-online.target

[Service]
Type=simple
User=votekit
Group=votekit
WorkingDirectory=/opt/votekit-current
Environment=NODE_ENV=production
EnvironmentFile=/etc/votekit/votekit.env
EnvironmentFile=-/etc/votekit/release.env
ExecStart=/usr/bin/node /opt/votekit-current/scripts/email-worker.mjs
Restart=always
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/votekit
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
