[Unit]
Description=Check GitHub for an approved VoteKit release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/votekit-release-watcher
# The orchestrator must use setpriv to run untrusted build steps as votekit.
# NoNewPrivileges would block that root-to-votekit transition.
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt /var/lib/votekit /var/backups/votekit /etc/votekit /run/lock
