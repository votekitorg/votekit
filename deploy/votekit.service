[Unit]
Description=VoteKit Election Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=votekit
Group=votekit
WorkingDirectory=/opt/votekit-current
Environment=NODE_ENV=production
EnvironmentFile=/etc/votekit/votekit.env
EnvironmentFile=-/etc/votekit/release.env
ExecStart=/usr/bin/node /opt/votekit-current/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/votekit /var/backups/votekit
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
