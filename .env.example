# Admin Authentication
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=your-secure-admin-password-here

# Email Configuration (Resend API)
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=noreply@yourorg.com
VOTEKIT_PUBLIC_URL=https://vote.yourorg.com

# Database (persistent SQLite file - automatically created)
DATABASE_PATH=./plebiscite.db

# Enable only when Node listens on localhost behind the documented nginx proxy.
TRUST_PROXY_HEADERS=true

# One-hour verification request limits. Tune for expected election size.
MAX_VERIFICATION_EMAIL_ATTEMPTS=3
MAX_VERIFICATION_IP_ATTEMPTS=500
MAX_VERIFICATION_GLOBAL_ATTEMPTS=5000

# Set by deployment so /api/health identifies the exact release.
VOTEKIT_RELEASE=development

# Experimental local encrypted-until-shuffled ballot mode. Keep false until
# the security review, rehearsal, and owner UAT release gates are complete.
VOTEKIT_ENCRYPTED_BALLOTS_ENABLED=false

# Environment
NODE_ENV=production
